### 4. Update a trip
PUT {{baseUrl}}/trips/ce89a959-9a69-496b-8ddc-0dd52894b497
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "pricePerSeat": 2000,
  "comments": "Prix mis à jour - Trajet premium",
  "availableSeats": 2,
  "possibleStops": {
    "stop_1": "Nouveau Marché",
    "stop_2": "Centre Commercial"
  }
}

### 5. Create a trip with optimization
POST {{baseUrl}}/trips/optimization
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "departureCoordinates": {
    "latitude": 48.8566,
    "longitude": 2.3522
  },
  "arrivalCoordinates": {
    "latitude": 50.6333,
    "longitude": 3.0667
  },
  "waypoints": [
    {
      "latitude": 44.8738,
      "longitude": 2.3480
    }
  ]
}

### 5. Test geocoding
POST {{baseUrl}}/trips/test-geocoding
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "address": " avepozo,Lomé,Togo"
}

### 6. Test reverse geocoding
POST {{baseUrl}}/trips/test-reverse-geocoding
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "latitude": 6.172674,
    "longitude": 1.349101
}

### 7. Test matrix (basique)
POST {{baseUrl}}/trips/test-matrix
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "coordinates": [
    {
      "latitude": 6.172674,
      "longitude": 1.349101
    },
    {
      "latitude": 6.182674,
      "longitude": 1.359101
    }
  ]
}

### 8. Test symmetric matrix (matrice symétrique)
POST {{baseUrl}}/trips/test-symmetric-matrix
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "coordinates": [
    {
      "latitude": 6.172674,
      "longitude": 1.349101
    },
    {
      "latitude": 6.182674,
      "longitude": 1.359101
    },
    {
      "latitude": 6.192674,
      "longitude": 1.369101
    }
  ]
}

### 9. Test one-to-many matrix (un point vers plusieurs)
POST {{baseUrl}}/trips/test-one-to-many-matrix
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "source": {
    "latitude": 6.172674,
    "longitude": 1.349101
  },
  "destinations": [
    {
      "latitude": 6.182674,
      "longitude": 1.359101
    },
    {
      "latitude": 6.192674,
      "longitude": 1.369101
    },
    {
      "latitude": 6.202674,
      "longitude": 1.379101
    }
  ]
}

### 10. Test many-to-one matrix (plusieurs points vers un)
POST {{baseUrl}}/trips/test-many-to-one-matrix
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "sources": [
    {
      "latitude": 6.172674,
      "longitude": 1.349101
    },
    {
      "latitude": 6.182674,
      "longitude": 1.359101
    },
    {
      "latitude": 6.192674,
      "longitude": 1.369101
    }
  ],
  "destination": {
    "latitude": 6.202674,
    "longitude": 1.379101
  }
}

### 11. Test traffic matrix (avec trafic)
POST {{baseUrl}}/trips/test-traffic-matrix
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "coordinates": [
    {
      "latitude": 6.172674,
      "longitude": 1.349101
    },
    {
      "latitude": 6.182674,
      "longitude": 1.359101
    }
  ],
  "departureTime": "2025-01-17T08:00:00Z"
}

### 12. Test curbside matrix (côté rue)
POST {{baseUrl}}/trips/test-curbside-matrix
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "coordinates": [
    {
      "latitude": 6.172674,
      "longitude": 1.349101
    },
    {
      "latitude": 6.182674,
      "longitude": 1.359101
    }
  ],
  "approaches": ["curb", "unrestricted"]
}

### 13. Test fallback matrix (avec fallback)
POST {{baseUrl}}/trips/test-fallback-matrix
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "coordinates": [
    {
      "latitude": 6.172674,
      "longitude": 1.349101
    },
    {
      "latitude": 6.182674,
      "longitude": 1.359101
    },
    {
      "latitude": 6.192674,
      "longitude": 1.369101
    }
  ],
  "fallbackSpeed": 25
}

### 14. Test nearest destination (destination la plus proche)
POST {{baseUrl}}/trips/test-nearest-destination
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "origin": {
    "latitude": 6.172674,
    "longitude": 1.349101
  },
  "destinations": [
    {
      "latitude": 6.182674,
      "longitude": 1.359101
    },
    {
      "latitude": 6.192674,
      "longitude": 1.369101
    },
    {
      "latitude": 6.202674,
      "longitude": 1.379101
    },
    {
      "latitude": 6.212674,
      "longitude": 1.389101
    }
  ]
}

